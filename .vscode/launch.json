{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: servidor local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8000"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DEBUG": "true"
      }
    },
    {
      "name": "Django: executar testes",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
